@using CricEco.GroundDashboard.Domain.Interfaces
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand flex items-center gap-3" href="/dashboard">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500 text-lg font-bold text-white">C</span>
            <span><strong>CricEco</strong><small class="block text-[10px] uppercase tracking-[0.2em] text-emerald-300">Owner console</small></span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/grounds">
                <span class="bi bi-grid-fill-nav-menu" aria-hidden="true"></span> My grounds
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/bookings">
                <span class="bi bi-calendar-event-fill-nav-menu" aria-hidden="true"></span> Bookings
            </NavLink>
        </div>

        <div class="nav-item px-3 mt-auto">
            <button type="button" class="nav-link w-full border-0 bg-transparent text-start" @onclick="LogOut">
                <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Log out
            </button>
        </div>
    </nav>
</div>

@code {
    private async Task LogOut()
    {
        await AuthService.SignOutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}

