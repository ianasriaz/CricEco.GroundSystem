@page "/grounds"
@using CricEco.GroundDashboard.Domain.Entities
@using CricEco.GroundDashboard.Domain.Interfaces
@inject IGroundRepository GroundRepository
@rendermode InteractiveServer

<PageTitle>My grounds | CricEco</PageTitle>

<div class="min-h-screen bg-slate-50 px-6 py-8 lg:px-10">
    <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Portfolio</p>
                <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">My grounds</h1>
                <p class="mt-2 text-slate-500">Keep your listings, rates and availability up to date.</p>
            </div>
            <button class="rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800">+ Add ground</button>
        </div>

        @if (grounds is null)
        {
            <div class="rounded-xl border border-slate-200 bg-white p-8 text-center text-slate-500">Loading grounds...</div>
        }
        else
        {
            <div class="grid gap-5 md:grid-cols-2">
                @foreach (var ground in grounds)
                {
                    <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <h2 class="text-lg font-bold text-slate-950">@ground.Name</h2>
                                <p class="mt-1 text-sm text-slate-500">@ground.Location</p>
                            </div>
                            <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">@(ground.IsActive ? "Active" : "Inactive")</span>
                        </div>
                        <div class="mt-6 grid grid-cols-3 gap-3 border-t border-slate-100 pt-5 text-sm">
                            <div><p class="text-slate-400">Rate</p><p class="mt-1 font-bold text-slate-900">PKR @ground.HourlyRate:N0</p></div>
                            <div><p class="text-slate-400">Pitch</p><p class="mt-1 font-bold text-slate-900">@ground.PitchType</p></div>
                            <div><p class="text-slate-400">Hours</p><p class="mt-1 font-bold text-slate-900">06:00 - 23:00</p></div>
                        </div>
                        <div class="mt-5 flex flex-wrap gap-2">
                            @foreach (var amenity in ground.Amenities.Take(3))
                            {
                                <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs text-slate-600">@amenity</span>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

@code {
    private IEnumerable<Ground>? grounds;

    protected override async Task OnInitializedAsync()
    {
        grounds = await GroundRepository.GetAllAsync();
    }
}