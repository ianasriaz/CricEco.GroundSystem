@page "/dashboard"
@using CricEco.GroundDashboard.Application.DTOs
@using CricEco.GroundDashboard.Application.Features.Bookings.Queries
@using MediatR
@inject IMediator Mediator
@rendermode InteractiveServer

<PageTitle>Dashboard | CricEco</PageTitle>

<div class="min-h-screen bg-slate-50 px-6 py-8 lg:px-10">
	<div class="mx-auto max-w-7xl">
		<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
			<div>
				<p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Owner console</p>
				<h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Good morning, Test Owner</h1>
				<p class="mt-2 text-slate-500">Here is what is happening across your grounds today.</p>
			</div>
			<a href="/grounds" class="rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800">Manage grounds</a>
		</div>

		@if (isLoading)
		{
			<div class="rounded-xl border border-slate-200 bg-white p-8 text-center text-slate-500">Loading your dashboard...</div>
		}
		else if (!string.IsNullOrWhiteSpace(errorMessage))
		{
			<div class="rounded-xl border border-red-200 bg-red-50 p-5 text-red-700">@errorMessage</div>
		}
		else if (stats is not null)
		{
			<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
				<StatCard Label="Active grounds" Value="@stats.TotalGrounds.ToString()" Detail="Across your portfolio" Accent="emerald" />
				<StatCard Label="Pending requests" Value="@stats.PendingRequests.ToString()" Detail="Need your attention" Accent="amber" />
				<StatCard Label="Confirmed bookings" Value="@stats.ConfirmedBookings.ToString()" Detail="Upcoming reservations" Accent="blue" />
				<StatCard Label="Confirmed revenue" Value="@($"PKR {stats.TotalRevenue:N0}")" Detail="From approved bookings" Accent="violet" />
			</div>

			<div class="mt-8 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
				<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
					<div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">
						<div>
							<h2 class="font-bold text-slate-950">Recent bookings</h2>
							<p class="mt-1 text-sm text-slate-500">The latest activity from your grounds.</p>
						</div>
						<a href="/bookings" class="text-sm font-semibold text-emerald-700 hover:text-emerald-800">View all</a>
					</div>
					<div class="divide-y divide-slate-100">
						@foreach (var booking in stats.RecentBookings)
						{
							<div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4">
								<div>
									<p class="font-semibold text-slate-900">@booking.CustomerName</p>
									<p class="mt-1 text-sm text-slate-500">@booking.GroundName · @booking.StartsAt.ToLocalTime().ToString("ddd, dd MMM · h:mm tt")</p>
								</div>
								<div class="text-right">
									<p class="font-semibold text-slate-900">PKR @booking.TotalAmount.ToString("N0")</p>
									<span class="text-xs font-semibold text-emerald-700">@booking.Status</span>
								</div>
							</div>
						}
					</div>
				</section>

				<section class="rounded-xl border border-slate-200 bg-white shadow-sm">
					<div class="border-b border-slate-100 px-6 py-5">
						<h2 class="font-bold text-slate-950">Your grounds</h2>
						<p class="mt-1 text-sm text-slate-500">Availability and hourly rates.</p>
					</div>
					<div class="divide-y divide-slate-100">
						@foreach (var ground in stats.Grounds)
						{
							<div class="flex items-center justify-between gap-3 px-6 py-4">
								<div>
									<p class="font-semibold text-slate-900">@ground.Name</p>
									<p class="mt-1 text-sm text-slate-500">@ground.Location · @ground.PitchType</p>
								</div>
								<div class="text-right">
									<p class="font-semibold text-slate-900">PKR @ground.HourlyRate.ToString("N0")</p>
									<p class="mt-1 text-xs text-emerald-700">@(ground.IsActive ? "Active" : "Inactive")</p>
								</div>
							</div>
						}
					</div>
				</section>
			</div>
		}
	</div>
</div>

@code {
	private DashboardStatsDto? stats;
	private bool isLoading = true;
	private string? errorMessage;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var result = await Mediator.Send(new GetDashboardStatsQuery());
			if (result.IsSuccess)
				stats = result.Value;
			else
				errorMessage = result.Error ?? "Unable to load dashboard data.";
		}
		catch (Exception)
		{
			errorMessage = "Unable to load dashboard data. Please refresh and try again.";
		}
		finally
		{
			isLoading = false;
		}
	}
}

