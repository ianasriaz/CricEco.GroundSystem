<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-sm font-medium text-slate-500">@Label</p>
    <p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">@Value</p>
    <p class="mt-2 text-xs text-slate-500">@Detail</p>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Detail { get; set; } = string.Empty;
    [Parameter] public string Accent { get; set; } = "emerald";
}